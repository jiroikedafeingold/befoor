    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Befoor reads your calendar to schedule gentle alarms before your appointments."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor liest deinen Kalender, um vor deinen Terminen sanfte Wecker zu stellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor lit votre calendrier pour programmer de douces alarmes avant vos rendez-vous."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor lee tu calendario para programar alarmas suaves antes de tus citas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor legge il tuo calendario per impostare sveglie delicate prima dei tuoi appuntamenti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Befoor lê seu calendário para programar alarmes suaves antes dos seus compromissos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor читает ваш календарь, чтобы ставить мягкие будильники перед встречами."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoorはカレンダーを読み取り、予定の前にやさしいアラームを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor는 캘린더를 읽어 일정 전에 부드러운 알람을 설정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor 会读取你的日历，在日程开始前设置柔和的闹钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor 會讀取你的行事曆，在行程開始前設定柔和的鬧鐘。"
          }
        }
      }
    },
