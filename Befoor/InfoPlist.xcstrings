    "NSAlarmKitUsageDescription" : {
      "comment" : "Privacy - AlarmKit Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor sets an alarm before each meeting so it rings even when your iPhone is on silent or in a Focus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor stellt vor jedem Termin einen Wecker, der auch klingelt, wenn dein iPhone stumm ist oder ein Fokus aktiv ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor règle une alarme avant chaque réunion pour qu’elle sonne même si votre iPhone est en silencieux ou en mode Concentration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor programa una alarma antes de cada reunión para que suene aunque tu iPhone esté en silencio o en un modo de concentración."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor imposta una sveglia prima di ogni riunione, così suona anche quando l’iPhone è in silenzioso o in una modalità Full immersion."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Befoor define um alarme antes de cada reunião para que ele toque mesmo com o iPhone no silencioso ou em um Foco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor ставит будильник перед каждой встречей, чтобы он звонил, даже если iPhone в беззвучном режиме или в режиме фокусирования."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoorは各ミーティングの前にアラームを設定し、iPhoneが消音モードや集中モードでも鳴るようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor는 각 회의 전에 알람을 설정해 iPhone이 무음 모드나 집중 모드여도 울리게 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor 会在每个会议前设置闹钟，即使 iPhone 处于静音或专注模式也会响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor 會在每個會議前設定鬧鐘，即使 iPhone 處於靜音或專注模式也會響。"
          }
        }
      }
    }
  },
  "version" : "1.3"
