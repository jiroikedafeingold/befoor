    },
    "Befoor needs to read your events" : {
      "comment" : "A description of the calendar permission.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor muss deine Termine lesen"
          }
        },
        "es" : {
