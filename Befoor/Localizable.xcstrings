    "Enable Background App Refresh for Befoor in iOS Settings so calendar changes are picked up even when you haven't opened the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die Hintergrundaktualisierung für Befoor in den iOS-Einstellungen, damit Kalenderänderungen erkannt werden, auch wenn du die App nicht geöffnet hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la actualización en segundo plano para Befoor en Ajustes de iOS para que se detecten los cambios del calendario aunque no hayas abierto la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’actualisation en arrière-plan pour Befoor dans les Réglages iOS afin que les modifications du calendrier soient prises en compte même si vous n’avez pas ouvert l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva l’aggiornamento in background per Befoor nelle Impostazioni iOS, così le modifiche al calendario vengono rilevate anche se non hai aperto l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSの設定でBefoorの「Appのバックグラウンド更新」をオンにすると、Appを開かなくてもカレンダーの変更が反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 설정에서 Befoor의 백그라운드 앱 새로 고침을 켜면 앱을 열지 않아도 캘린더 변경 사항이 반영됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a atualização em segundo plano para o Befoor nos Ajustes do iOS para que mudanças no calendário sejam detectadas mesmo sem abrir o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите обновление в фоне для Befoor в Настройках iOS, чтобы изменения календаря подхватывались, даже если вы не открывали приложение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iOS 设置中为 Befoor 开启“后台 App 刷新”，这样即使没有打开 App 也能获取日历的更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 iOS 設定中為 Befoor 開啟「背景 App 重新整理」，這樣即使沒有打開 App 也能取得行事曆的變更。"
          }
        }
      }
    },
    "Enable Befoor" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befoor aktivieren"
          }
        },
