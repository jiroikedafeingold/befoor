    "Snooze rings again after your snooze time. Stop ends the alarm; the meeting's last alert still rings." : {
      "comment" : "Text describing the snooze and stop functionality of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlummern klingelt nach deiner Schlummerzeit erneut. Beenden stoppt den Wecker; der letzte Hinweis des Termins klingelt trotzdem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posponer vuelve a sonar tras el tiempo de posposición. Detener apaga la alarma; el último aviso de la reunión sonará igualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répéter fait sonner à nouveau après le délai de répétition. Arrêter coupe l’alarme ; la dernière alerte de la réunion sonne quand même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posticipa suona di nuovo dopo il tempo di posticipo. Ferma spegne la sveglia; l’ultimo avviso della riunione suona comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スヌーズするとスヌーズ時間の後にもう一度鳴ります。停止するとアラームが止まりますが、ミーティングの最後の通知は鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 알림을 누르면 설정한 시간 후에 다시 울립니다. 중단을 누르면 알람이 꺼지지만, 회의의 마지막 알림은 그대로 울립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiar toca de novo depois do tempo de adiamento. Parar encerra o alarme; o último alerta da reunião ainda toca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Отложить» снова зазвонит через заданное время. «Остановить» выключает будильник; последний сигнал встречи всё равно прозвучит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“稍后提醒”会在设定时间后再次响起。“停止”会关闭闹钟；会议的最后一次提醒仍会响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「稍後提醒」會在設定的時間後再次響起。「停止」會關閉鬧鐘；會議的最後一次提醒仍會響。"
          }
        }
      }
    },
    "Snooze rings the alarm again after your snooze time. Stop ends it. Either way, the meeting's last alert still rings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlummern lässt den Wecker nach deiner Schlummerzeit erneut klingeln. Beenden stoppt ihn. In beiden Fällen klingelt der letzte Hinweis des Termins trotzdem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posponer hace que la alarma vuelva a sonar tras el tiempo de posposición. Detener la apaga. En ambos casos, el último aviso de la reunión sonará igualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répéter fait sonner l’alarme à nouveau après le délai de répétition. Arrêter la coupe. Dans les deux cas, la dernière alerte de la réunion sonne quand même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posticipa fa suonare di nuovo la sveglia dopo il tempo di posticipo. Ferma la spegne. In entrambi i casi, l’ultimo avviso della riunione suona comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スヌーズするとスヌーズ時間の後にアラームがもう一度鳴ります。停止すると止まります。どちらの場合も、ミーティングの最後の通知は鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 알림을 누르면 설정한 시간 후에 알람이 다시 울립니다. 중단을 누르면 꺼집니다. 어느 쪽이든 회의의 마지막 알림은 그대로 울립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiar faz o alarme tocar de novo depois do tempo de adiamento. Parar o encerra. Em ambos os casos, o último alerta da reunião ainda toca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Отложить» снова включит будильник через заданное время. «Остановить» выключает его. В обоих случаях последний сигнал встречи всё равно прозвучит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“稍后提醒”会在设定时间后让闹钟再次响起。“停止”会关闭它。无论哪种方式，会议的最后一次提醒仍会响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「稍後提醒」會在設定的時間後讓鬧鐘再次響起。「停止」會關閉它。無論哪種方式，會議的最後一次提醒仍會響。"
          }
        }
      }
    },
    "Snoozed reminder" : {
      "comment" : "Subtitle for a snoozed reminder notification.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
