    "No alarms for meetings before this date, for a vacation or a day off. Alarms come back on their own afterwards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Wecker für Termine vor diesem Datum – für Urlaub oder einen freien Tag. Danach sind die Wecker von selbst wieder da."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin alarmas para las reuniones anteriores a esta fecha, para unas vacaciones o un día libre. Después, las alarmas vuelven solas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune alarme pour les réunions avant cette date, pour des vacances ou un jour de congé. Les alarmes reviennent ensuite d’elles-mêmes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna sveglia per le riunioni prima di questa data, per una vacanza o un giorno libero. Poi le sveglie tornano da sole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休暇や休みの日のために、この日時より前のミーティングはアラームを鳴らしません。その後アラームは自動的に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴가나 쉬는 날을 위해 이 날짜 전의 회의는 알람을 울리지 않습니다. 이후에는 알람이 자동으로 돌아옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem alarmes para reuniões antes desta data, para férias ou um dia de folga. Depois, os alarmes voltam sozinhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без будильников для встреч до этой даты — на время отпуска или выходного. Потом будильники вернутся сами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休假或休息日时，此日期之前的会议不会响铃。之后闹钟会自动恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
