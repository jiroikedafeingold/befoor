    "Add words like \"lunch\" or \"OOO\" and any event whose title contains those words will be skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Wörter wie „Mittagessen“ oder „OOO“ hinzu – jeder Termin, dessen Titel eines dieser Wörter enthält, wird übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade palabras como «almuerzo» o «fuera» y se omitirá cualquier evento cuyo título las contenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des mots comme « déjeuner » ou « absent » : tout événement dont le titre contient l’un de ces mots sera ignoré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi parole come «pranzo» o «fuori ufficio»: ogni evento il cui titolo contiene una di queste parole verrà ignorato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ランチ」や「不在」などの語を追加すると、タイトルにそれらを含むイベントはスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'점심'이나 '부재' 같은 단어를 추가하면 제목에 그 단어가 들어간 이벤트는 건너뜁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione palavras como “almoço” ou “ausente” e qualquer evento cujo título contenha essas palavras será ignorado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте слова вроде «обед» или «нет на месте» — любое событие, в названии которого они есть, будет пропущено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加“午餐”或“外出”之类的词，标题包含这些词的日程都会被跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入「午餐」或「外出」之類的字詞，標題含有這些字詞的行程都會被略過。"
          }
        }
      }
    },
    "Add, move, or cancel a meeting and Befoor updates your alarms the next time it opens or checks in the background." : {
      "comment" : "Text describing how to update your meetings using Befoor.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Termin hinzu, verschiebe oder sage ihn ab – Befoor aktualisiert deine Wecker, sobald es das nächste Mal geöffnet wird oder im Hintergrund nachsieht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade, mueve o cancela una reunión y Befoor actualizará tus alarmas la próxima vez que se abra o compruebe en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez, déplacez ou annulez une réunion : Befoor met à jour vos alarmes la prochaine fois qu’il s’ouvre ou vérifie en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi, sposta o annulla una riunione e Befoor aggiornerà le sveglie la prossima volta che si apre o controlla in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミーティングを追加、移動、キャンセルすると、Befoorは次に開いたときやバックグラウンドで確認したときにアラームを更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회의를 추가, 이동 또는 취소하면 Befoor가 다음에 열리거나 백그라운드에서 확인할 때 알람을 업데이트합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione, mova ou cancele uma reunião e o Befoor atualiza seus alarmes na próxima vez que for aberto ou verificar em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте, перенесите или отмените встречу, и Befoor обновит будильники, когда откроется или проверит календарь в фоне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加、移动或取消会议后，Befoor 会在下次打开或在后台检查时更新闹钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入、移動或取消會議後，Befoor 會在下次打開或在背景檢查時更新鬧鐘。"
          }
        }
      }
    },
