    "A quiet notification each morning with how many meetings you have and when the first one starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine leise Mitteilung jeden Morgen: wie viele Termine du hast und wann der erste beginnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación silenciosa cada mañana con cuántas reuniones tienes y cuándo empieza la primera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification discrète chaque matin : le nombre de réunions de la journée et l’heure de la première."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notifica silenziosa ogni mattina con quante riunioni hai e quando inizia la prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎朝、その日のミーティングの数と最初のミーティングの開始時刻を静かに通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 아침 오늘 회의 개수와 첫 회의 시작 시간을 조용히 알려 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação silenciosa toda manhã com quantas reuniões você tem e quando começa a primeira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихое уведомление каждое утро: сколько у вас встреч и когда начинается первая."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天早上发送一条安静的通知，告诉你今天有几个会议以及第一个会议何时开始。"
          }
        },
        "zh-Hant" : {
