          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отложенное напоминание"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稍后提醒"
          }
