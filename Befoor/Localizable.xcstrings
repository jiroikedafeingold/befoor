    "%@ at %@. Check the invite before you join." : {
      "comment" : "The body of a notification that a video call link has been removed or changed. The first argument is the title of the meeting. The second argument is the start time of the meeting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ um %@. Prüfe die Einladung, bevor du beitrittst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ at %2$@. Check the invite before you join."
          }
        },
