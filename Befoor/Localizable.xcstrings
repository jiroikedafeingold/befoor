    "An alarm rings the configured number of minutes before each appointment — so you're never caught off guard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wecker klingelt die eingestellte Anzahl Minuten vor jedem Termin – damit du nie überrascht wirst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una alarma suena los minutos que elijas antes de cada cita, para que nunca te pille por sorpresa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une alarme sonne le nombre de minutes choisi avant chaque rendez-vous, pour que vous ne soyez jamais pris au dépourvu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sveglia suona il numero di minuti scelto prima di ogni appuntamento, così non sarai mai colto di sorpresa."
          }
        },
        "ja" : {
