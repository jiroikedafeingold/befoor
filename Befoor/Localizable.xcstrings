    "Meetings with a Zoom, Google Meet, Teams or Webex link get a Join button, in the list and on the countdown." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine mit einem Zoom-, Google-Meet-, Teams- oder Webex-Link erhalten eine Beitreten-Taste, in der Liste und im Countdown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reuniones con un enlace de Zoom, Google Meet, Teams o Webex tienen un botón Unirse, en la lista y en la cuenta atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réunions avec un lien Zoom, Google Meet, Teams ou Webex ont un bouton Rejoindre, dans la liste et dans le compte à rebours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le riunioni con un link Zoom, Google Meet, Teams o Webex hanno un pulsante Partecipa, nell’elenco e nel conto alla rovescia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom、Google Meet、Teams、Webexのリンクがあるミーティングには、リストとカウントダウンに「参加」ボタンが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom, Google Meet, Teams 또는 Webex 링크가 있는 회의에는 목록과 카운트다운에 참여 버튼이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reuniões com um link do Zoom, Google Meet, Teams ou Webex ganham um botão Entrar, na lista e na contagem regressiva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У встреч со ссылкой Zoom, Google Meet, Teams или Webex появляется кнопка «Войти» — в списке и в обратном отсчёте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带有 Zoom、Google Meet、Teams 或 Webex 链接的会议会在列表和倒计时中显示“加入”按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含有 Zoom、Google Meet、Teams 或 Webex 連結的會議，會在列表和倒數中顯示「加入」按鈕。"
          }
        }
      }
    },
